# Dependencies
node_modules/

# One-time scripts (do not commit)
scripts/

# Environment variables and secrets
.env
.env.local
.env.*.local

# Build output
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# User-uploaded content (keep the folders so multer can write to them)
public/uploads/avatars/*
public/uploads/attachments/*
!public/uploads/avatars/.gitkeep
!public/uploads/attachments/.gitkeep
