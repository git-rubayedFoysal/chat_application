# Example environment configuration.
# Copy this file to `.env` and replace the placeholder values.
# The app validates all of these at startup and exits if they are missing or invalid.

# HTTP port the server listens on (integer, 1-65535)
PORT=5000

# MongoDB connection string (include the database name)
Mongo_URI=mongodb://127.0.0.1:27017/chat-application

# Secret used to verify signed cookies (any non-empty string)
COOKIE_SECRET=change-me-to-a-long-random-string

# Environment: development | production | test
NODE_ENV=development

# Secret used to sign JWTs (any non-empty string)
JWT_SECRET=change-me-to-a-long-random-string

# JWT lifetime (jsonwebtoken `expiresIn` format, e.g. 3600 for seconds or "7d")
JWT_EXPIRATION=7d

# Name of the auth cookie (any non-empty string)
COOKIE_NAME=chat_token

# Auth cookie lifetime in milliseconds (positive integer; 7 days = 604800000)
COOKIE_MAX_AGE=604800000
